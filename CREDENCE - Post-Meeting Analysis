        "jsCode": "\nvar searchResults = $input.all();\nvar metadata = $('Extract Meeting Metadata').item.json;\n\nvar hasName  = !!metadata.prospectName;\nvar hasEmail = !!metadata.prospectEmail;\nvar hasId    = !!metadata.prospectId;\n\nif (!hasName && !hasEmail && !hasId) {\n  return [{\n    json: {\n      status: 'error',\n      errorType: 'missing_metadata',\n      errorMessage:\n        'CREDENCE ALERT: Meeting Review — Missing Required Fields\\n\\n' +\n        'Document: \"' + (metadata.docName || 'Unknown') + '\"\\n' +\n        'URL: ' + (metadata.docUrl || 'N/A') + '\\n\\n' +\n        'Could not extract identifying fields. Please ensure your Meeting Review includes these fields at the top:\\n\\n' +\n        '  Prospect ID:     [from original Prospect Brief]\\n' +\n        '  Prospect Name:   [full name]\\n' +\n        '  Prospect Email:  [email address]\\n' +\n        '  Company:         [company name]\\n\\n' +\n        'Re-save the document after correcting it to re-trigger this workflow.',\n      metadata: metadata,\n    }\n  }];\n}\n\n// Filter to real file entries only (discard alwaysOutputData empty items)\nvar files = searchResults\n  .map(function(i) { return i.json; })\n  .filter(function(f) { return f && f.id && f.name; });\n\nif (files.length === 0) {\n  return [{\n    json: {\n      status: 'error',\n      errorType: 'no_match',\n      errorMessage:\n        'CREDENCE ALERT: No Matching Prospect Brief Found\\n\\n' +\n        'Searched for:\\n' +\n        '  Name:         ' + (metadata.prospectName  || 'Not extracted') + '\\n' +\n        '  Company:      ' + (metadata.company       || 'Not extracted') + '\\n' +\n        '  Email:        ' + (metadata.prospectEmail || 'Not extracted') + '\\n' +\n        '  Prospect ID:  ' + (metadata.prospectId    || 'Not extracted') + '\\n\\n' +\n        'Please verify that a Prospect Brief titled \"Prospect Brief - [Name] - [Company]\" exists in the Prospect Briefs folder.',\n      metadata: metadata,\n    }\n  }];\n}\n\nvar matches = files.slice();\n\n// Narrow by company name if multiple results\nif (matches.length > 1 && metadata.company) {\n  var byCompany = matches.filter(function(f) {\n    return f.name &&\n      f.name.toLowerCase().indexOf(metadata.company.toLowerCase()) !== -1;\n  });\n  if (byCompany.length >= 1) {\n    matches = byCompany;\n  }\n}\n\nif (matches.length > 1) {\n  var nameList = matches.map(function(f) { return '  - ' + f.name; }).join('\\n');\n  return [{\n    json: {\n      status: 'error',\n      errorType: 'multiple_matches',\n      errorMessage:\n        'CREDENCE ALERT: Multiple Matching Prospect Briefs Found\\n\\n' +\n        'Found ' + matches.length + ' matches for \"' + (metadata.prospectName || 'Unknown') + '\":\\n\\n' +\n        nameList + '\\n\\n' +\n        'No analysis was generated to avoid using the wrong data.\\n' +\n        'Resolution: Check for duplicates in the Prospect Briefs folder, or add a more specific Prospect ID to the Meeting Review.',\n      metadata: metadata,\n    }\n  }];\n}\n\nvar brief = matches[0];\nreturn [{\n  json: {\n    status: 'ok',\n    briefFileId: brief.id,\n    briefName: brief.name,\n    metadata: metadata,\n  }\n}];\n"
      },
