    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nvar briefContent   = $input.item.json.content || '';\nvar validationData = $('Validate Match').item.json;\nvar meetingData    = $('Extract Meeting Metadata').item.json;\nvar metadata       = validationData.metadata || meetingData;\n\nvar prompt =\n  'You are analyzing a post-meeting intelligence report for Blossom Affia.' +\n  ' She uses the SEE LOCK OFFER methodology from \"The $10K Message\".\\n\\n' +\n  'PROSPECT INFORMATION (from Meeting Review)\\n' +\n  'Prospect ID:  ' + (metadata.prospectId   || 'Not provided') + '\\n' +\n  'Name:         ' + (metadata.prospectName  || 'Unknown')      + '\\n' +\n  'Email:        ' + (metadata.prospectEmail || 'Not provided') + '\\n' +\n  'Company:      ' + (metadata.company       || 'Unknown')      + '\\n' +\n  'Job Title:    ' + (metadata.jobTitle      || 'Not provided') + '\\n' +\n  'Meeting Date: ' + (metadata.meetingDate   || 'Not provided') + '\\n\\n' +\n  'ORIGINAL PROSPECT BRIEF (pre-meeting intelligence — publicly observed facts and hypotheses)\\n' +\n  '---\\n' +\n  briefContent +\n  '\\n---\\n\\n' +\n  'MEETING REVIEW (actual meeting outcome — this is the PRIMARY source of truth)\\n' +\n  '---\\n' +\n  (meetingData.docContent || 'Not available') +\n  '\\n---\\n\\n' +\n  'TASK\\n' +\n  'Compare these two sources and generate a post-meeting analysis.\\n' +\n  'The Meeting Review is what ACTUALLY happened. Treat it as the primary source.\\n' +\n  'The Prospect Brief contains pre-meeting PUBLIC observations and hypotheses.\\n\\n' +\n  'RULES\\n' +\n  '1. Never invent information. Write \"No reliable evidence found\" when insufficient.\\n' +\n  '2. Distinguish: publicly observed vs. meeting-confirmed vs. prospect-stated.\\n' +\n  '3. Only include SEE LOCK entries where meeting evidence is clear.\\n' +\n  '4. follow_up_message must sound human and specific, not corporate.\\n' +\n  '5. recommendation must be specific to this prospect. No generic advice.\\n\\n' +\n  'Return ONLY valid JSON. No markdown fences. No text outside JSON.\\n\\n' +\n  '{\\n' +\n  '  \"prospect\": {\\n' +\n  '    \"prospect_id\": \"' + (metadata.prospectId   || '') + '\",\\n' +\n  '    \"name\": \"'         + (metadata.prospectName  || '') + '\",\\n' +\n  '    \"email\": \"'        + (metadata.prospectEmail || '') + '\",\\n' +\n  '    \"company\": \"'      + (metadata.company       || '') + '\",\\n' +\n  '    \"job_title\": \"'    + (metadata.jobTitle      || '') + '\",\\n' +\n  '    \"meeting_date\": \"' + (metadata.meetingDate   || '') + '\"\\n' +\n  '  },\\n' +\n  '  \"pre_meeting_summary\": \"Summary of pre-meeting research and what was hypothesized\",\\n' +\n  '  \"meeting_summary\": \"Summary of what happened — stated problems, goals, key moments\",\\n' +\n  '  \"confirmed_problems\": [\"array of problems the prospect explicitly stated or confirmed\"],\\n' +\n  '  \"confirmed_goals\": [\"array of goals the prospect explicitly stated or confirmed\"],\\n' +\n  '  \"new_information\": [\"information discovered in meeting not in the pre-meeting brief\"],\\n' +\n  '  \"pre_meeting_assumptions_confirmed\": [\"hypotheses from the original brief confirmed by the meeting\"],\\n' +\n  '  \"pre_meeting_assumptions_rejected_or_changed\": [\"hypotheses contradicted or significantly changed\"],\\n' +\n  '  \"see_lock_analysis\": [{\"see\": \"observation\", \"lock\": \"gap or friction it reveals\", \"evidence\": \"direct quote or data\", \"confidence\": \"High/Medium/Low\"}],\\n' +\n  '  \"key_opportunities\": [\"specific opportunities based on meeting evidence\"],\\n' +\n  '  \"recommended_next_step\": \"the single most important next action for Blossom\",\\n' +\n  '  \"recommendation\": \"specific recommendation — what to do, why, and how — for THIS prospect only\",\\n' +\n  '  \"follow_up_message\": \"personalized message Blossom sends to the prospect — specific, human, concise, with a clear next step\",\\n' +\n  '  \"important_cautions\": [\"key risks, contradictions, or uncertainties to be aware of\"],\\n' +\n  '  \"sources\": [\"Original Prospect Brief\", \"Meeting Review - ' + (metadata.docName || 'Unknown') + '\"]\\n' +\n  '}';\n\nreturn {\n  prompt:    prompt,\n  metadata:  metadata,\n  briefName: validationData.briefName || '',\n  docUrl:    metadata.docUrl || '',\n};\n"
      },
