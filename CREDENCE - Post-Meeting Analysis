      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nvar item     = $input.item;\nvar prepData = $('Prepare Analysis').item.json;\nvar metadata = prepData.metadata;\n\n// Get raw text from AI response\nvar rawText = '';\nif (item.json.text) {\n  rawText = String(item.json.text);\n} else if (item.json.message && item.json.message.content) {\n  rawText = String(item.json.message.content);\n} else {\n  rawText = JSON.stringify(item.json);\n}\n\n// Strip markdown code fences (no regex with backticks needed)\nvar jsonText = rawText.trim();\nif (jsonText.length > 3 && jsonText.substring(0, 3) === '```') {\n  var firstNewline = jsonText.indexOf('\\n');\n  if (firstNewline !== -1) {\n    jsonText = jsonText.substring(firstNewline + 1).trim();\n  }\n  if (jsonText.length >= 3 && jsonText.substring(jsonText.length - 3) === '```') {\n    jsonText = jsonText.substring(0, jsonText.length - 3).trim();\n  }\n}\n\nvar analysis;\ntry {\n  analysis = JSON.parse(jsonText);\n} catch (e) {\n  return {\n    status: 'error',\n    errorMessage:\n      'CREDENCE ALERT: AI Response Could Not Be Parsed\\n\\n' +\n      'Prospect: ' + (metadata.prospectName || 'Unknown') + ' — ' + (metadata.company || 'Unknown') + '\\n' +\n      'Meeting Date: ' + (metadata.meetingDate || 'Unknown') + '\\n\\n' +\n      'The AI returned an invalid response. Please re-save the Meeting Review to retry.\\n\\n' +\n      'Error: ' + e.message,\n    metadata: metadata,\n  };\n}\n\nif (!analysis.prospect || !analysis.recommendation) {\n  return {\n    status: 'error',\n    errorMessage:\n      'CREDENCE ALERT: AI Analysis Incomplete\\n\\n' +\n      'Prospect: ' + (metadata.prospectName || 'Unknown') + ' — ' + (metadata.company || 'Unknown') + '\\n\\n' +\n      'The AI analysis is missing required fields (prospect info or recommendation). Please re-save the Meeting Review to retry.',\n    metadata: metadata,\n  };\n}\n\nvar p            = analysis.prospect || {};\nvar prospectName = p.name      || metadata.prospectName  || 'Unknown';\nvar company      = p.company   || metadata.company       || 'Unknown';\nvar docTitle     = 'Post-Meeting Analysis - ' + prospectName + ' - ' + company;\n\nfunction fmtList(arr) {\n  if (!arr || arr.length === 0) return 'None identified.';\n  return arr.map(function(s) { return '  * ' + s; }).join('\\n');\n}\n\nfunction fmtSeeLock(arr) {\n  if (!arr || arr.length === 0) return 'No SEE LOCK analysis identified.';\n  return arr.map(function(s, i) {\n    return '[' + (i + 1) + ']\\n' +\n      'SEE:        ' + (s.see        || 'N/A') + '\\n' +\n      'LOCK:       ' + (s.lock       || 'N/A') + '\\n' +\n      'Evidence:   ' + (s.evidence   || 'N/A') + '\\n' +\n      'Confidence: ' + (s.confidence || 'N/A');\n  }).join('\\n\\n');\n}\n\nvar today = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });\n\nvar docContent =\n  'POST-MEETING ANALYSIS\\n' +\n  'Generated by CREDENCE | ' + today + '\\n' +\n  '===================================================\\n\\n' +\n\n  '1. PROSPECT INFORMATION\\n' +\n  '---------------------------------------------------\\n' +\n  'Name:           ' + prospectName + '\\n' +\n  'Company:        ' + company + '\\n' +\n  'Job Title:      ' + (p.job_title    || metadata.jobTitle      || 'N/A') + '\\n' +\n  'Email:          ' + (p.email        || metadata.prospectEmail || 'N/A') + '\\n' +\n  'Prospect ID:    ' + (p.prospect_id  || metadata.prospectId    || 'N/A') + '\\n' +\n  'Meeting Date:   ' + (p.meeting_date || metadata.meetingDate   || 'N/A') + '\\n' +\n  'Original Brief: ' + (prepData.briefName || 'N/A') + '\\n\\n' +\n\n  '2. PRE-MEETING SUMMARY\\n' +\n  '---------------------------------------------------\\n' +\n  (analysis.pre_meeting_summary || 'Not available.') + '\\n\\n' +\n\n  '3. MEETING SUMMARY\\n' +\n  '---------------------------------------------------\\n' +\n  (analysis.meeting_summary || 'Not available.') + '\\n\\n' +\n\n  '4. CONFIRMED PROBLEMS\\n' +\n  '---------------------------------------------------\\n' +\n  fmtList(analysis.confirmed_problems) + '\\n\\n' +\n\n  '5. CONFIRMED GOALS\\n' +\n  '---------------------------------------------------\\n' +\n  fmtList(analysis.confirmed_goals) + '\\n\\n' +\n\n  '6. NEW INFORMATION (discovered in meeting)\\n' +\n  '---------------------------------------------------\\n' +\n  fmtList(analysis.new_information) + '\\n\\n' +\n\n  '7. WHAT CHANGED FROM THE ORIGINAL BRIEF\\n' +\n  '---------------------------------------------------\\n' +\n  'Assumptions CONFIRMED:\\n' +\n  fmtList(analysis.pre_meeting_assumptions_confirmed) + '\\n\\n' +\n  'Assumptions REJECTED OR CHANGED:\\n' +\n  fmtList(analysis.pre_meeting_assumptions_rejected_or_changed) + '\\n\\n' +\n\n  '8. SEE LOCK ANALYSIS\\n' +\n  '---------------------------------------------------\\n' +\n  fmtSeeLock(analysis.see_lock_analysis) + '\\n\\n' +\n\n  '9. KEY OPPORTUNITIES\\n' +\n  '---------------------------------------------------\\n' +\n  fmtList(analysis.key_opportunities) + '\\n\\n' +\n\n  '10. RECOMMENDATION\\n' +\n  '---------------------------------------------------\\n' +\n  (analysis.recommendation || 'No recommendation generated.') + '\\n\\n' +\n\n  '11. RECOMMENDED NEXT STEP\\n' +\n  '---------------------------------------------------\\n' +\n  (analysis.recommended_next_step || 'Not specified.') + '\\n\\n' +\n\n  '12. PERSONALIZED FOLLOW-UP MESSAGE\\n' +\n  '---------------------------------------------------\\n' +\n  (analysis.follow_up_message || 'No follow-up message generated.') + '\\n\\n' +\n\n  '13. IMPORTANT CAUTIONS\\n' +\n  '---------------------------------------------------\\n' +\n  fmtList(analysis.important_cautions) + '\\n\\n' +\n\n  '14. SOURCES\\n' +\n  '---------------------------------------------------\\n' +\n  fmtList(analysis.sources) + '\\n\\n' +\n\n  '===================================================\\n' +\n  'End of Post-Meeting Analysis — Generated by CREDENCE';\n\nvar mainProblem = (analysis.confirmed_problems && analysis.confirmed_problems[0]) || 'Not specified';\nvar mainGoal    = (analysis.confirmed_goals    && analysis.confirmed_goals[0])    || 'Not specified';\n\nreturn {\n  status:       'ok',\n  analysis:     analysis,\n  docTitle:     docTitle,\n  docContent:   docContent,\n  prospectName: prospectName,\n  company:      company,\n  prospectEmail: (p.email        || metadata.prospectEmail || ''),\n  meetingDate:   (p.meeting_date || metadata.meetingDate   || 'Unknown'),\n  mainProblem:  mainProblem,\n  mainGoal:     mainGoal,\n  nextStep:     analysis.recommended_next_step || 'Not specified',\n  followUp:     analysis.follow_up_message     || 'Not generated',\n  docUrl:       metadata.docUrl || '',\n  metadata:     metadata,\n};\n"
