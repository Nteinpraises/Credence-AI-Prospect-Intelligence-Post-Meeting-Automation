        "mode": "runOnceForEachItem",
        "jsCode": "\nvar content = $input.item.json.content || '';\nvar triggerData = $('Detect New Meeting Review').item.json;\nvar docName = triggerData.name || '';\nvar docId   = triggerData.id   || '';\nvar docUrl  = docId ? 'https://docs.google.com/document/d/' + docId : '';\n\n// Parse fields line by line (no regex required)\nvar lines = content.split('\\n');\nvar fields = {};\nfor (var i = 0; i < lines.length; i++) {\n  var line = lines[i].trim();\n  if (!line) continue;\n  var colonIdx = line.indexOf(':');\n  // Only treat as a field if colon is within 50 chars (avoids body text with colons)\n  if (colonIdx > 0 && colonIdx < 50) {\n    var key   = line.substring(0, colonIdx).trim().toLowerCase();\n    var value = line.substring(colonIdx + 1).trim();\n    if (value && !fields[key]) {\n      fields[key] = value;\n    }\n  }\n}\n\nfunction getField(keys) {\n  for (var i = 0; i < keys.length; i++) {\n    var k = keys[i].toLowerCase();\n    if (fields[k]) return fields[k];\n  }\n  return '';\n}\n\nvar prospectId    = getField(['prospect id', 'prospect_id', 'prospectid']);\nvar prospectName  = getField(['prospect name', 'prospect_name', 'name']);\nvar prospectEmail = getField(['prospect email', 'prospect_email', 'email']);\nvar company       = getField(['company']);\nvar jobTitle      = getField(['job title', 'job_title', 'jobtitle', 'title']);\nvar meetingDate   = getField(['meeting date', 'meeting_date', 'meetingdate', 'date']);\n\n// Extract section bodies using indexOf (handles variant headers)\nvar transcriptHeaders = [\n  'Meeting Transcript / Notes:',\n  'Meeting Transcript/Notes:',\n  'Meeting Transcript / Notes',\n  'Meeting Notes:',\n  'Transcript:',\n  'Notes:'\n];\nvar reviewHeaders = [\n  \"Blossom's Review:\",\n  \"Blossoms Review:\",\n  \"Blossom Review:\",\n  \"My Review:\"\n];\n\nfunction findSection(text, headers) {\n  for (var i = 0; i < headers.length; i++) {\n    var idx = text.indexOf(headers[i]);\n    if (idx !== -1) {\n      return { start: idx, headerLen: headers[i].length };\n    }\n  }\n  return null;\n}\n\nvar transcriptSection = findSection(content, transcriptHeaders);\nvar reviewSection     = findSection(content, reviewHeaders);\n\nvar transcript   = '';\nvar blossomReview = '';\n\nif (transcriptSection) {\n  var tEnd = reviewSection ? reviewSection.start : content.length;\n  transcript = content.substring(transcriptSection.start + transcriptSection.headerLen, tEnd).trim();\n}\nif (reviewSection) {\n  blossomReview = content.substring(reviewSection.start + reviewSection.headerLen).trim();\n}\n\nreturn {\n  docId:         docId,\n  docName:       docName,\n  docUrl:        docUrl,\n  docContent:    content,\n  transcript:    transcript,\n  blossomReview: blossomReview,\n  prospectId:    prospectId,\n  prospectName:  prospectName,\n  prospectEmail: prospectEmail,\n  company:       company,\n  jobTitle:      jobTitle,\n  meetingDate:   meetingDate,\n};\n"
      },
