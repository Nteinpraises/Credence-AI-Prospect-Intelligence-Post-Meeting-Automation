        "jsCode": "const form = $json;\n\n// Helper: tries multiple possible column name variants.\n// Google Forms uses the question text as the column header, so we cover\n// the most common capitalisation and spacing variants.\nconst get = function(keys) {\n  for (let i = 0; i < keys.length; i++) {\n    const v = form[keys[i]];\n    if (v !== undefined && v !== null && String(v).trim() !== '') return String(v).trim();\n  }\n  return '';\n};\n\nconst prospectEmail = get(['Email Address', 'Email', 'email', 'email_address']).toLowerCase();\nconst meetingDate   = get(['Meeting Date', 'Meeting date', 'meeting_date', 'Date of Meeting']);\nconst rawId = prospectEmail.replace(/[^a-z0-9]/g, '') + meetingDate.replace(/[^0-9]/g, '');\nconst prospectId = 'P-' + rawId.substring(0, 16) + '-' + Date.now().toString(36);\n\nreturn [{\n  json: {\n    prospect_id:      prospectId,\n    prospect_name:    get(['Full Name', 'Name', 'full_name', 'name']),\n    prospect_email:   prospectEmail,\n    company_name:     get(['Company Name', 'Company', 'company_name', 'company']),\n    job_title:        get(['Job Title / Role', 'Job Title', 'Role', 'job_title', 'role', 'Title']),\n    company_website:  get(['Company Website', 'Website', 'company_website', 'website', 'Company URL']),\n    linkedin_profile: get(['LinkedIn Profile', 'LinkedIn', 'linkedin_profile', 'linkedin', 'LinkedIn URL']),\n    company_linkedin: get(['Company LinkedIn', 'Company LinkedIn Page', 'company_linkedin', 'Company LinkedIn URL']),\n    meeting_reason:   get(['Reason for Meeting', 'Reason', 'meeting_reason', 'reason', 'Meeting Reason', 'Purpose']),\n    meeting_date:     meetingDate,\n    additional_context: get(['Additional Context', 'Additional context', 'additional_context', 'context', 'Notes', 'notes']),\n    submitted_at:     new Date().toISOString(),\n  }\n}];"
