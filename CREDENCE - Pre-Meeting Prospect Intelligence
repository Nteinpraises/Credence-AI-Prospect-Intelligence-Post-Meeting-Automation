      "parameters": {
        "jsCode": "const prospect = $('Normalize Prospect Data').first().json;\nconst LF = String.fromCharCode(10);\n\n// --- Company Website ---\nlet websiteContent = 'Unable to retrieve website content.';\ntry {\n  const webNode = $('Research - Company Website').first().json;\n  const rawHtml = (webNode.data || '').substring(0, 8000);\n  websiteContent = rawHtml\n    .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n    .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n    .replace(/<[^>]+>/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim()\n    .substring(0, 3000);\n  if (!websiteContent) websiteContent = 'Website content could not be extracted.';\n} catch(e) {\n  websiteContent = 'Website research failed: ' + e.message;\n}\n\n// --- Format Tavily Results ---\nconst formatSearch = function(nodeData, label) {\n  try {\n    const data = nodeData || {};\n    const lines = [label + ':'];\n    if (data.answer) lines.push('Summary: ' + data.answer);\n    const results = data.results || [];\n    if (results.length === 0) {\n      lines.push('No results found.');\n    } else {\n      results.forEach(function(r, i) {\n        lines.push('');\n        lines.push('Result ' + (i + 1) + ':');\n        lines.push('  Title: ' + (r.title || ''));\n        lines.push('  URL: ' + (r.url || ''));\n        lines.push('  Content: ' + (r.content || '').substring(0, 600));\n      });\n    }\n    return lines.join(LF);\n  } catch(e) {\n    return label + ': Research step failed.';\n  }\n};\n\nlet prospectSearchData = {};\ntry { prospectSearchData = $('Research - Prospect & Company').first().json; } catch(e) {}\n\nlet newsData = {};\ntry { newsData = $('Research - Company News').first().json; } catch(e) {}\n\nlet linkedinData = {};\ntry { linkedinData = $('Research - LinkedIn Presence').first().json; } catch(e) {}\n\n// --- Build the compiled prompt ---\nconst sections = [\n  '=== PROSPECT DATA ===',\n  'Name: ' + prospect.prospect_name,\n  'Email: ' + prospect.prospect_email,\n  'Company: ' + prospect.company_name,\n  'Job Title: ' + prospect.job_title,\n  'Website: ' + prospect.company_website,\n  'LinkedIn Profile: ' + (prospect.linkedin_profile || 'Not provided'),\n  'Company LinkedIn: ' + (prospect.company_linkedin || 'Not provided'),\n  'Meeting Date: ' + prospect.meeting_date,\n  'Reason for Meeting: ' + prospect.meeting_reason,\n  'Additional Context: ' + (prospect.additional_context || 'None provided'),\n  '',\n  '=== COMPANY WEBSITE CONTENT ===',\n  websiteContent,\n  '',\n  '=== PUBLIC RESEARCH RESULTS ===',\n  formatSearch(prospectSearchData, 'PROSPECT & COMPANY SEARCH'),\n  '',\n  formatSearch(newsData, 'COMPANY NEWS & ANNOUNCEMENTS'),\n  '',\n  formatSearch(linkedinData, 'LINKEDIN SEARCH'),\n];\n\nreturn [{\n  json: {\n    prospect_id: prospect.prospect_id,\n    prospect_name: prospect.prospect_name,\n    prospect_email: prospect.prospect_email,\n    company_name: prospect.company_name,\n    job_title: prospect.job_title,\n    company_website: prospect.company_website,\n    linkedin_profile: prospect.linkedin_profile,\n    company_linkedin: prospect.company_linkedin,\n    meeting_date: prospect.meeting_date,\n    meeting_reason: prospect.meeting_reason,\n    additional_context: prospect.additional_context,\n    submitted_at: prospect.submitted_at,\n    compiled_prompt: sections.join(LF),\n  }\n}];"
      },
