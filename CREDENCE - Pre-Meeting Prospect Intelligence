    {
      "parameters": {
        "jsCode": "const a = $input.first().json;\nconst LF = String.fromCharCode(10);\nconst SEP = '==================================================';\n\nconst prospect = a.prospect || {};\nconst prospectName  = prospect.name  || a.prospect_name_raw  || '';\nconst companyName   = prospect.company || a.company_name_raw || '';\nconst prospectEmail = prospect.email || a.prospect_email_raw || '';\nconst jobTitle      = prospect.role  || a.job_title_raw      || '';\nconst meetingDate   = prospect.meeting_date || a.meeting_date_raw || '';\nconst meetingReason = prospect.meeting_reason || a.meeting_reason_raw || '';\n\nconst formatSignals = function(signals) {\n  if (!signals || signals.length === 0) return 'No reliable public evidence found.';\n  return signals.map(function(s) {\n    const lines = [];\n    if (s.signal_type)   lines.push('Signal: '        + s.signal_type);\n    if (s.observation)   lines.push('Observation: '   + s.observation);\n    if (s.evidence)      lines.push('Evidence: '      + s.evidence);\n    if (s.source)        lines.push('Source: '        + s.source);\n    if (s.interpretation) lines.push('Interpretation: ' + s.interpretation);\n    if (s.confidence)    lines.push('Confidence: '    + s.confidence);\n    return lines.join(LF);\n  }).join(LF + LF);\n};\n\nconst formatSeeLock = function(items) {\n  if (!items || items.length === 0) return 'Insufficient evidence for SEE -> LOCK analysis.';\n  return items.map(function(item) {\n    const lines = [];\n    if (item.see)      lines.push('SEE: '      + item.see);\n    lines.push('');\n    if (item.lock)     lines.push('LOCK: '     + item.lock);\n    lines.push('');\n    if (item.known)    lines.push('Known: '    + item.known);\n    if (item.inferred) lines.push('Inferred: ' + item.inferred);\n    if (item.unknown)  lines.push('Unknown: '  + item.unknown);\n    if (item.confidence) lines.push('Confidence: ' + item.confidence);\n    return lines.join(LF);\n  }).join(LF + LF);\n};\n\nconst formatList = function(items) {\n  if (!items || items.length === 0) return 'None identified.';\n  return items.map(function(item, i) {\n    return (i + 1) + '. ' + (typeof item === 'string' ? item : JSON.stringify(item));\n  }).join(LF);\n};\n\nconst formatSources = function(sources) {\n  if (!sources || sources.length === 0) return 'No sources recorded.';\n  return sources.map(function(src) { return '- ' + src; }).join(LF);\n};\n\nconst parts = [\n  'CREDENCE PROSPECT INTELLIGENCE BRIEF',\n  SEP,\n  '',\n  'Prospect:     ' + prospectName,\n  'Company:      ' + companyName,\n  'Role:         ' + jobTitle,\n  'Email:        ' + prospectEmail,\n  'Meeting Date: ' + meetingDate,\n  '',\n  SEP,\n  'REASON FOR MEETING',\n  SEP,\n  '',\n  meetingReason,\n  '',\n  SEP,\n  'EXECUTIVE SUMMARY',\n  SEP,\n  '',\n  a.overview || 'No summary available.',\n  '',\n  SEP,\n  'PUBLIC POSITIONING',\n  SEP,\n  '',\n  a.public_positioning || 'No reliable public evidence found.',\n  '',\n  SEP,\n  'KEY PUBLIC SIGNALS',\n  SEP,\n  '',\n  formatSignals(a.signals),\n  '',\n  SEP,\n  'SEE -> LOCK ANALYSIS',\n  SEP,\n  '',\n  formatSeeLock(a.see_lock_analysis),\n  '',\n  SEP,\n  'DISCUSSION OPPORTUNITIES',\n  SEP,\n  '',\n  formatList(a.discussion_opportunities),\n  '',\n  SEP,\n  'SUGGESTED QUESTIONS',\n  SEP,\n  '',\n  formatList(a.suggested_questions),\n  '',\n  SEP,\n  'IMPORTANT CAUTIONS',\n  SEP,\n  '',\n  formatList(a.important_cautions),\n  '',\n  SEP,\n  'RESEARCH SOURCES',\n  SEP,\n  '',\n  formatSources(a.sources),\n  '',\n  SEP,\n  'Brief prepared by Credence Prospect Intelligence System',\n  'Generated: ' + new Date().toISOString(),\n  SEP,\n];\n\nconst docContent = parts.join(LF);\nconst docTitle = 'Prospect Brief - ' + prospectName + ' - ' + companyName;\n\nreturn [{\n  json: {\n    doc_content:    docContent,\n    doc_title:      docTitle,\n    prospect_id:    a.prospect_id,\n    prospect_name:  prospectName,\n    company_name:   companyName,\n    prospect_email: prospectEmail,\n    job_title:      jobTitle,\n    meeting_date:   meetingDate,\n    meeting_reason: meetingReason,\n    submitted_at:   a.submitted_at,\n  }\n}];"
      },
