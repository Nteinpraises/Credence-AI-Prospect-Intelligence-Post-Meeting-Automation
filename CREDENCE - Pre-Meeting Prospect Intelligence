      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst collectNode = $('Collect & Compile Research').first().json;\nlet analysis = null;\n\n// Case 1: jsonOutput:true with simplify:true returns parsed object directly\nif (input && typeof input === 'object' && (input.prospect !== undefined || input.signals !== undefined || input.overview !== undefined)) {\n  analysis = input;\n}\n\n// Case 2: Response is a string in text/output/content fields that needs parsing\nif (!analysis) {\n  const candidates = [input.text, input.output, input.content, input.message, input.response];\n  for (let i = 0; i < candidates.length; i++) {\n    const src = candidates[i];\n    if (typeof src === 'string' && src.trim().length > 0) {\n      try {\n        const cleaned = src\n          .replace(/^[\\s]*```json[\\s]*/i, '')\n          .replace(/^[\\s]*```[\\s]*/i, '')\n          .replace(/[\\s]*```[\\s]*$/i, '')\n          .trim();\n        analysis = JSON.parse(cleaned);\n        break;\n      } catch(e) {}\n    }\n  }\n}\n\n// Fallback: structured error object so the workflow continues\nif (!analysis) {\n  analysis = {\n    parse_error: true,\n    raw_response_preview: JSON.stringify(input).substring(0, 300),\n    prospect: {\n      name: collectNode.prospect_name || '',\n      email: collectNode.prospect_email || '',\n      company: collectNode.company_name || '',\n      role: collectNode.job_title || '',\n      website: collectNode.company_website || '',\n      linkedin: collectNode.linkedin_profile || '',\n      meeting_date: collectNode.meeting_date || '',\n      meeting_reason: collectNode.meeting_reason || '',\n    },\n    overview: 'AI analysis output could not be parsed. Please review the workflow execution log.',\n    public_positioning: '',\n    signals: [],\n    see_lock_analysis: [],\n    discussion_opportunities: ['AI analysis failed - manual review required.'],\n    suggested_questions: [],\n    important_cautions: ['AI analysis failed. Review the execution log before the meeting.'],\n    sources: [],\n  };\n}\n\n// Ensure all arrays exist\nconst ensureArray = function(v) { return Array.isArray(v) ? v : []; };\nanalysis.signals = ensureArray(analysis.signals);\nanalysis.see_lock_analysis = ensureArray(analysis.see_lock_analysis);\nanalysis.discussion_opportunities = ensureArray(analysis.discussion_opportunities);\nanalysis.suggested_questions = ensureArray(analysis.suggested_questions);\nanalysis.important_cautions = ensureArray(analysis.important_cautions);\nanalysis.sources = ensureArray(analysis.sources);\n\nreturn [{\n  json: Object.assign({}, analysis, {\n    prospect_id: collectNode.prospect_id,\n    submitted_at: collectNode.submitted_at,\n    prospect_email_raw: collectNode.prospect_email,\n    company_name_raw: collectNode.company_name,\n    prospect_name_raw: collectNode.prospect_name,\n    job_title_raw: collectNode.job_title,\n    meeting_date_raw: collectNode.meeting_date,\n    meeting_reason_raw: collectNode.meeting_reason,\n  })\n}];"
      },
